{
  "format": "eligibility-clause/1",
  "source_id": "eligsample",
  "archive_id": "arc_48ae4261e83d7b1d3128bb5f7603d951",
  "version_no": 1,
  "notice_key": "E-9001",
  "title": "关于2026年度重点资助项目申报资格预审条件的通告（公众版）",
  "description": "错误串档示例：绑定公众版却引用完整版团队条件",
  "scope": {
    "subject": {
      "description": "申请主体（一个申报单位）",
      "fields": {
        "entity_type": "string",
        "registered_years": "decimal",
        "legal_registered_on": "date",
        "has_integrity_issue": "boolean"
      }
    },
    "member": {
      "description": "团队成员（每名成员一份资料；role=pi 的成员即项目负责人）",
      "fields": {
        "role": "string",
        "degree_level": "string",
        "years_experience": "decimal"
      }
    }
  },
  "conditions": [
    {
      "id": "ROOT",
      "scope": "subject",
      "description": "预审总条件：主体、负责人、团队、诚信四项均满足",
      "citation": {
        "start": 0,
        "end": 33,
        "quote": "各申报单位：现就2026年度重点资助项目申报资格预审条件通告如下。"
      },
      "expr": {
        "all": [
          {
            "ref": "ENTITY_KIND"
          },
          {
            "ref": "ENTITY_YEARS"
          },
          {
            "ref": "LEGAL_DATE"
          },
          {
            "ref": "PI_CONDITION"
          },
          {
            "ref": "COUNT_DOCTORS"
          },
          {
            "ref": "INTEGRITY_OK"
          }
        ]
      }
    },
    {
      "id": "ENTITY_KIND",
      "scope": "subject",
      "description": "申报主体须为高校、科研院所或企业",
      "citation": {
        "start": 44,
        "end": 67,
        "quote": "申报主体应为本市依法登记的高校、科研院所或企业"
      },
      "expr": {
        "field": "entity_type",
        "op": "in",
        "values": [
          "university",
          "research_institute",
          "enterprise"
        ]
      }
    },
    {
      "id": "ENTITY_YEARS",
      "scope": "subject",
      "description": "登记年限不少于 3 年（含边界）",
      "citation": {
        "start": 68,
        "end": 77,
        "quote": "登记年限不少于3年"
      },
      "expr": {
        "field": "registered_years",
        "op": "ge",
        "value": "3"
      }
    },
    {
      "id": "LEGAL_DATE",
      "scope": "subject",
      "description": "法人登记日期在 2021-01-01 之后（含当日）",
      "citation": {
        "start": 78,
        "end": 102,
        "quote": "法人登记日期须在2021年1月1日之后（含当日）"
      },
      "expr": {
        "field": "legal_registered_on",
        "op": "ge",
        "value": "2021-01-01"
      }
    },
    {
      "id": "PI_DEGREE",
      "scope": "member",
      "description": "项目负责人具有博士学位",
      "citation": {
        "start": 115,
        "end": 140,
        "quote": "项目负责人须具有博士学位，且从事研究工作不少于5年"
      },
      "expr": {
        "field": "degree_level",
        "op": "eq",
        "value": "doctorate"
      }
    },
    {
      "id": "PI_YEARS",
      "scope": "member",
      "description": "项目负责人从事研究工作不少于 5 年",
      "citation": {
        "start": 115,
        "end": 140,
        "quote": "项目负责人须具有博士学位，且从事研究工作不少于5年"
      },
      "expr": {
        "field": "years_experience",
        "op": "ge",
        "value": "5"
      }
    },
    {
      "id": "PI_CONDITION",
      "scope": "subject",
      "description": "负责人条件：定位 role=pi 的成员，并在同一个人身上同时核验学历与年限",
      "citation": {
        "start": 115,
        "end": 140,
        "quote": "项目负责人须具有博士学位，且从事研究工作不少于5年"
      },
      "expr": {
        "count": {
          "predicate": {
            "all": [
              {
                "field": "role",
                "op": "eq",
                "value": "pi"
              },
              {
                "ref": "PI_DEGREE"
              },
              {
                "ref": "PI_YEARS"
              }
            ]
          },
          "at_least": 1
        }
      }
    },
    {
      "id": "COUNT_DOCTORS",
      "scope": "subject",
      "description": "核心团队至少 2 名博士，且每名博士成员从事研究不少于 3 年",
      "citation": {
        "start": 152,
        "end": 183,
        "quote": "团队中至少2名成员应具有博士学位，且每人从事研究工作不少于3年"
      },
      "expr": {
        "count": {
          "predicate": {
            "all": [
              {
                "field": "degree_level",
                "op": "eq",
                "value": "doctorate"
              },
              {
                "field": "years_experience",
                "op": "ge",
                "value": "3"
              }
            ]
          },
          "at_least": 2
        }
      }
    },
    {
      "id": "INTEGRITY_OK",
      "scope": "subject",
      "description": "近 5 年无科研诚信失信记录（本条款以“有失信记录”为反例；无记录不等于已核实）",
      "citation": {
        "start": 195,
        "end": 219,
        "quote": "申报主体及团队成员近5年内不得有科研诚信失信记录"
      },
      "expr": {
        "field": "has_integrity_issue",
        "op": "eq",
        "value": false
      }
    }
  ],
  "root": "ROOT"
}
